# Local development only. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only key (preferred): never expose in browser, HTML, JS or Git.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy fallback only; current Supabase projects should use SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=
# Legacy anon fallback if publishable keys are unavailable.
# SUPABASE_ANON_KEY=
# Generate at least 32 random bytes; keep only in a server-side secret store.
CPF_HASH_SECRET=
SITE_URL=https://localhost:8080
